# No compressor or Python dependency is needed by ordinary platform builds.
cmake_minimum_required(VERSION 3.22)
if(NOT DEFINED SURGE_SCORING_SOURCE_DIR)
  get_filename_component(SURGE_SCORING_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
if(NOT DEFINED SURGE_EMBEDDED_DATA_DIR)
  set(SURGE_EMBEDDED_DATA_DIR "${SURGE_SCORING_SOURCE_DIR}/resources/data")
endif()
set(_shared "${SURGE_SCORING_SOURCE_DIR}/resources/surge-shared")
file(READ "${_shared}/scoring-factory.json" _index)
string(JSON _count GET "${_index}" entry_count)
string(JSON _length LENGTH "${_index}" entries)
string(JSON _presets GET "${_index}" preset_count)
string(JSON _skins GET "${_index}" skin_count)
string(JSON _uncompressed GET "${_index}" uncompressed_bytes)
string(JSON _packed_hash GET "${_index}" compressed_sha256)
string(JSON _packed_size GET "${_index}" compressed_bytes)
string(JSON _payload_hash GET "${_index}" payload_sha256)
string(JSON _catalog_hash GET "${_index}" catalog_sha256)
if(NOT _count EQUAL _length OR _count GREATER 1200 OR NOT _presets EQUAL 1000
    OR NOT _skins EQUAL 10 OR _uncompressed GREATER 67108864)
  message(FATAL_ERROR "Invalid embedded factory payload counts/size")
endif()
file(SHA256 "${_shared}/scoring-factory.sxtz" _actual_hash)
file(SIZE "${_shared}/scoring-factory.sxtz" _actual_size)
if(NOT _actual_hash STREQUAL _packed_hash OR NOT _actual_size EQUAL _packed_size)
  message(FATAL_ERROR "Embedded factory payload bytes changed; regenerate embed_factory.py")
endif()
file(READ "${_shared}/scoring-factory.id" _identity)
string(STRIP "${_identity}" _identity)
if(NOT _identity STREQUAL _payload_hash)
  message(FATAL_ERROR "Embedded factory payload identity mismatch")
endif()
file(SHA256 "${SURGE_SCORING_SOURCE_DIR}/doc/scoring-1000/manifest.json" _actual_hash)
if(NOT _actual_hash STREQUAL _catalog_hash)
  message(FATAL_ERROR "Embedded factory payload belongs to a different scoring catalog")
endif()

file(GLOB_RECURSE _expected_patches RELATIVE "${SURGE_EMBEDDED_DATA_DIR}"
  "${SURGE_EMBEDDED_DATA_DIR}/patches_factory/Scoring 1000/*.fxp")
file(GLOB _skin_dirs LIST_DIRECTORIES true "${SURGE_EMBEDDED_DATA_DIR}/skins/reference-*.surge-skin")
list(LENGTH _expected_patches _preset_count)
list(LENGTH _skin_dirs _skin_count)
if(NOT _preset_count EQUAL 1000 OR NOT _skin_count EQUAL 10)
  message(FATAL_ERROR "Embedded factory source/stage must contain 1000 presets and ten reference skins")
endif()
set(_expected ${_expected_patches})
foreach(_skin IN LISTS _skin_dirs)
  if(NOT EXISTS "${_skin}/skin.xml" OR NOT EXISTS "${_skin}/workspace.json")
    message(FATAL_ERROR "Incomplete embedded reference skin ${_skin}")
  endif()
  file(GLOB_RECURSE _skin_files RELATIVE "${SURGE_EMBEDDED_DATA_DIR}" "${_skin}/*")
  list(APPEND _expected ${_skin_files})
endforeach()
set(_actual)
set(_casefold)
math(EXPR _last "${_count}-1")
foreach(_i RANGE ${_last})
  string(JSON _path GET "${_index}" entries ${_i} path)
  string(JSON _hash GET "${_index}" entries ${_i} sha256)
  string(JSON _size GET "${_index}" entries ${_i} bytes)
  if(IS_ABSOLUTE "${_path}" OR _path MATCHES "(^|/)\\.\\.?(/|$)" OR _path MATCHES "[\\\\:;]"
      OR NOT _path IN_LIST _expected)
    message(FATAL_ERROR "Unsafe or unexpected embedded factory path: ${_path}")
  endif()
  string(TOLOWER "${_path}" _lower)
  if(_lower IN_LIST _casefold)
    message(FATAL_ERROR "Duplicate or case-colliding embedded factory path: ${_path}")
  endif()
  list(APPEND _casefold "${_lower}")
  list(APPEND _actual "${_path}")
  set(_file "${SURGE_EMBEDDED_DATA_DIR}/${_path}")
  if(IS_SYMLINK "${_file}")
    message(FATAL_ERROR "Embedded factory data must be an ordinary file: ${_path}")
  endif()
  file(SHA256 "${_file}" _actual_hash)
  file(SIZE "${_file}" _actual_size)
  if(NOT _actual_hash STREQUAL _hash OR NOT _actual_size EQUAL _size)
    message(FATAL_ERROR "Embedded factory content is stale for ${_path}; run embed_factory.py")
  endif()
endforeach()
list(SORT _actual)
list(SORT _expected)
if(NOT _actual STREQUAL _expected)
  message(FATAL_ERROR "Embedded factory index does not cover the exact source/staged file set")
endif()
message(STATUS "Embedded factory content verified: 1000 presets, 10 skins, ${_packed_size} compressed bytes")
