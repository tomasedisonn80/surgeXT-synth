# Run independently with cmake -P, at configure, before installation, and before
# packaging. This lightweight check deliberately has no Python dependency.
cmake_minimum_required(VERSION 3.22)

if(NOT DEFINED SURGE_SCORING_SOURCE_DIR)
  get_filename_component(SURGE_SCORING_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
if(NOT DEFINED SURGE_SCORING_DATA_DIR)
  set(SURGE_SCORING_DATA_DIR "${SURGE_SCORING_SOURCE_DIR}/resources/data")
endif()

set(_index "${SURGE_SCORING_SOURCE_DIR}/doc/scoring-1000/package.sha256")
set(_manifest "${SURGE_SCORING_SOURCE_DIR}/doc/scoring-1000/manifest.json")
if(NOT EXISTS "${_index}" OR NOT EXISTS "${_manifest}")
  message(FATAL_ERROR "Scoring 1000 catalog or packaging index is missing. Restore the complete bank or run scripts/scoring/build_bank.py.")
endif()

set(_categories
  "01 Keys" "02 Plucks" "03 Bells and Mallets" "04 Pads"
  "05 Ensemble Hybrids" "06 Drones and Air" "07 Bass" "08 Leads"
  "09 Pulses and Sequences" "10 Percussion and Transitions")
foreach(_category IN LISTS _categories)
  string(SUBSTRING "${_category}" 0 2 _id)
  set(_count_${_id} 0)
endforeach()

file(STRINGS "${_index}" _rows ENCODING UTF-8)
list(LENGTH _rows _row_count)
if(NOT _row_count EQUAL 1001)
  message(FATAL_ERROR "Scoring 1000 packaging index must contain one manifest and exactly 1000 presets; found ${_row_count} lines.")
endif()
set(_manifest_seen FALSE)
set(_expected)
foreach(_row IN LISTS _rows)
  if(NOT _row MATCHES "^([0-9a-f]+)  (.+)$")
    message(FATAL_ERROR "Invalid Scoring 1000 checksum row: ${_row}")
  endif()
  set(_sha "${CMAKE_MATCH_1}")
  set(_relative "${CMAKE_MATCH_2}")
  string(LENGTH "${_sha}" _sha_length)
  if(NOT _sha_length EQUAL 64)
    message(FATAL_ERROR "Invalid SHA-256 length for ${_relative}")
  endif()

  if(_relative STREQUAL "doc/scoring-1000/manifest.json")
    if(_manifest_seen)
      message(FATAL_ERROR "Duplicate manifest row in Scoring 1000 packaging index")
    endif()
    set(_manifest_seen TRUE)
    set(_file "${_manifest}")
  else()
    if(NOT _relative MATCHES "^resources/data/(patches_factory/Scoring 1000/([0-9][0-9] [^/]+)/SC[0-9][0-9]-[0-9][0-9][0-9] [^/]+[.]fxp)$")
      message(FATAL_ERROR "Unexpected Scoring 1000 package path: ${_relative}")
    endif()
    set(_data_relative "${CMAKE_MATCH_1}")
    set(_category "${CMAKE_MATCH_2}")
    if(NOT _category IN_LIST _categories)
      message(FATAL_ERROR "Unexpected Scoring 1000 category: ${_category}")
    endif()
    if(_relative MATCHES "(^|/)\\.\\.(/|$)" OR _relative MATCHES "\\\\")
      message(FATAL_ERROR "Unsafe Scoring 1000 package path: ${_relative}")
    endif()
    string(SUBSTRING "${_category}" 0 2 _id)
    math(EXPR _count_${_id} "${_count_${_id}} + 1")
    list(APPEND _expected "${_data_relative}")
    set(_file "${SURGE_SCORING_DATA_DIR}/${_data_relative}")
  endif()

  if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}")
    message(FATAL_ERROR "Missing Scoring 1000 package file: ${_file}")
  endif()
  file(SHA256 "${_file}" _actual_sha)
  if(NOT _actual_sha STREQUAL _sha)
    message(FATAL_ERROR "Scoring 1000 SHA-256 mismatch: ${_file}. Regenerate the bank and packaging index together.")
  endif()
endforeach()

if(NOT _manifest_seen)
  message(FATAL_ERROR "Scoring 1000 packaging index is not bound to its manifest")
endif()
foreach(_category IN LISTS _categories)
  string(SUBSTRING "${_category}" 0 2 _id)
  if(NOT _count_${_id} EQUAL 100)
    message(FATAL_ERROR "Scoring 1000 category ${_category} has ${_count_${_id}} presets; expected 100")
  endif()
endforeach()
list(SORT _expected)
list(LENGTH _expected _preset_count)
list(REMOVE_DUPLICATES _expected)
list(LENGTH _expected _unique_count)
if(NOT _preset_count EQUAL 1000 OR NOT _unique_count EQUAL 1000)
  message(FATAL_ERROR "Scoring 1000 requires exactly 1000 distinct package paths")
endif()
# Match extensions consistently on case-sensitive and case-insensitive hosts.
# An unexpected .FXP must not evade the complete-file-set check on Linux.
file(GLOB_RECURSE _bank_files LIST_DIRECTORIES FALSE RELATIVE "${SURGE_SCORING_DATA_DIR}"
  "${SURGE_SCORING_DATA_DIR}/patches_factory/Scoring 1000/*")
set(_actual)
foreach(_file IN LISTS _bank_files)
  string(TOLOWER "${_file}" _lower_file)
  if(_lower_file MATCHES "[.]fxp$")
    list(APPEND _actual "${_file}")
  endif()
endforeach()
list(SORT _actual)
if(NOT _actual STREQUAL _expected)
  message(FATAL_ERROR "Scoring 1000 files do not exactly match the packaging index in ${SURGE_SCORING_DATA_DIR}")
endif()
message(STATUS "Scoring 1000: verified 1000 SHA-256 hashes, 10 categories and catalog binding in ${SURGE_SCORING_DATA_DIR}")
